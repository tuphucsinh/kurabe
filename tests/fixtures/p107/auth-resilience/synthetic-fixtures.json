  "proxyScenarios": {
    "absentTrustConfig": {
      "headers": {
        "x-forwarded-for": "203.0.113.195",
        "cf-connecting-ip": "198.51.100.1"
      },
      "config": {},
      "expectedClientIp": "127.0.0.1",
      "expectedIsTrustedProxy": false
    },
    "malformedHopsConfig": {
      "headers": {
        "x-forwarded-for": "203.0.113.195, 10.0.0.1"
      },
      "config": {
        "immediatePeer": "10.0.0.1",
        "trustedProxies": ["10.0.0.1"],
        "trustedHops": -1
      },
      "expectedClientIp": "10.0.0.1",
      "expectedIsTrustedProxy": false
    },
    "malformedProxyList": {
      "headers": {
        "x-forwarded-for": "203.0.113.195, 10.0.0.1"
      },
      "config": {
        "immediatePeer": "10.0.0.1",
        "trustedProxies": ["10.0.0.1", "invalid_proxy_ip_syntax"]
      },
      "expectedClientIp": "10.0.0.1",
      "expectedIsTrustedProxy": false
    },
    "untrustedImmediatePeer": {
      "headers": {
        "x-forwarded-for": "203.0.113.195"
      },
      "config": {
        "immediatePeer": "198.51.100.99",
        "trustedProxies": ["10.0.0.1"]
      },
      "expectedClientIp": "198.51.100.99",
      "expectedIsTrustedProxy": false
    },
    "trustedProxySingleHop": {
      "headers": {
        "x-forwarded-for": "198.51.100.5, 10.0.0.1"
      },
      "config": {
        "immediatePeer": "10.0.0.1",
        "trustedProxies": ["10.0.0.1"]
      },
      "expectedClientIp": "198.51.100.5",
      "expectedIsTrustedProxy": true
    },
    "trustedProxyMultiHop": {
      "headers": {
        "x-forwarded-for": "198.51.100.50, 10.0.0.2, 10.0.0.1"
      },
      "config": {
        "immediatePeer": "10.0.0.1",
        "trustedProxies": ["10.0.0.1", "10.0.0.2"]
      },
      "expectedClientIp": "198.51.100.50",
      "expectedIsTrustedProxy": true
    }
  }
}
